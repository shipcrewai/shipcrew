[Unit]
Description=Pacto bot shipply-gate-1
After=network.target

[Service]
Type=simple
User=pacto-bot
Group=pacto-bot
WorkingDirectory=/opt/shipply-gate-1
ExecStart=/usr/local/bin/python3 -m shipply_gate_1
Restart=on-failure
Environment="PACTO_TRANSPORT=unix"
Environment="PACTO_SOCKET_PATH=/run/pacto-bot-api.sock"

[Install]
WantedBy=multi-user.target
